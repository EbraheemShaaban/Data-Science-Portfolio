   "source": [
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "cv_rows = []\n",
    "\n",
    "for dataset_name, (X, y) in zip(dataset_names, datasets):\n",
    "    for name, classifier in zip(names, classifiers):\n",
    "        model = make_pipeline(StandardScaler(), clone(classifier))\n",
    "        scores = cross_val_score(\n",
    "            model, X, y, cv=cv, scoring=\"accuracy\", n_jobs=-1\n",
    "        )\n",
    "        cv_rows.append({\n",
    "            \"Dataset\": dataset_name,\n",
    "            \"Classifier\": name,\n",
    "            \"CV Accuracy Mean\": scores.mean(),\n",
    "            \"CV Accuracy Std\": scores.std(),\n",
    "        })\n",
    "\n",
    "cv_df = pd.DataFrame(cv_rows)\n",
    "cv_df.round(3).sort_values(\n",
    "    [\"Dataset\", \"CV Accuracy Mean\"], ascending=[True, False]\n",
    ").reset_index(drop=True)"
   ]
  },
